# Credentials for infra/docker-compose.yml (local development only).
# Copy to infra/.env, which git ignores, and replace the values:
#   cp infra/.env.example infra/.env
#   docker compose --env-file infra/.env -f infra/docker-compose.yml up -d

# PostgreSQL password for the "ai_video" user. backend/.env.example's
# AI_VIDEO_DATABASE_URL assumes this default.
POSTGRES_PASSWORD=ai_video

# MinIO root credentials (the password must be at least 8 characters).
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
