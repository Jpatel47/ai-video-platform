AI_VIDEO_APP_NAME="AI Video Platform"
AI_VIDEO_ENVIRONMENT=local
AI_VIDEO_LOG_LEVEL=INFO
AI_VIDEO_CORS_ORIGINS='["http://localhost:3000","http://127.0.0.1:3000"]'
# Database, Redis and S3 settings are placeholders: the backend does not use them yet.
AI_VIDEO_DATABASE_URL=postgresql+psycopg://ai_video:ai_video@localhost:5432/ai_video
AI_VIDEO_REDIS_URL=redis://localhost:6379/0
AI_VIDEO_S3_ENDPOINT_URL=http://localhost:9000
AI_VIDEO_S3_BUCKET_NAME=ai-video-assets
AI_VIDEO_OLLAMA_BASE_URL=http://localhost:11434
# Use a small fast model for the director role; large models overheat laptops
AI_VIDEO_OLLAMA_DIRECTOR_MODEL=llama3.2
AI_VIDEO_OLLAMA_REQUEST_TIMEOUT_SECONDS=600
AI_VIDEO_PROVIDER_HEALTH_TIMEOUT_SECONDS=5
AI_VIDEO_COMFYUI_BASE_URL=http://localhost:8188
# Leave unset to auto-discover the first installed checkpoint
#AI_VIDEO_COMFYUI_CHECKPOINT=dreamshaper_8.safetensors
AI_VIDEO_COMFYUI_IMAGE_WIDTH=768
AI_VIDEO_COMFYUI_IMAGE_HEIGHT=768
AI_VIDEO_COMFYUI_SAMPLING_STEPS=20
AI_VIDEO_COMFYUI_REQUEST_TIMEOUT_SECONDS=600
